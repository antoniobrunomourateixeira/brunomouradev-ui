{
  "name": "@brunomouradev/pivot-grid",
  "version": "0.1.5",
  "description": "PivotGrid Web Component — tabela dinâmica com hierarquias, subtotais, filtros, arrastar campos entre áreas e exportação CSV. Funciona em Angular, React, Vue ou HTML puro.",
  "license": "MIT",
  "author": "brunomouradev",
  "homepage": "https://github.com/antoniobrunomourateixeira/brunomouradev-ui/tree/main/packages/pivot-grid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoniobrunomourateixeira/brunomouradev-ui.git",
    "directory": "packages/pivot-grid"
  },
  "bugs": {
    "url": "https://github.com/antoniobrunomourateixeira/brunomouradev-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.umd.cjs",
    "./src/index.ts"
  ],
  "keywords": [
    "web-components",
    "pivot",
    "pivotgrid",
    "pivot-table",
    "olap",
    "lit",
    "angular",
    "react",
    "vue"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@brunomouradev/data-grid": "0.1.5",
    "lit": "3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
