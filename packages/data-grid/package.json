{
  "name": "@brunomouradev/data-grid",
  "version": "0.1.5",
  "description": "DataGrid Web Component — ordenação, filtro, busca, paginação, seleção, totais e exportação CSV. Funciona em Angular, React, Vue ou HTML puro.",
  "license": "MIT",
  "author": "brunomouradev",
  "homepage": "https://github.com/antoniobrunomourateixeira/brunomouradev-ui/tree/main/packages/data-grid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoniobrunomourateixeira/brunomouradev-ui.git",
    "directory": "packages/data-grid"
  },
  "bugs": {
    "url": "https://github.com/antoniobrunomourateixeira/brunomouradev-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "typesVersions": {
    "*": {
      "engine": [
        "./dist/types/engine/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "engine",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.umd.cjs",
    "./src/index.ts",
    "./src/data-grid.ts"
  ],
  "keywords": [
    "web-components",
    "datagrid",
    "data-grid",
    "table",
    "lit",
    "angular",
    "react",
    "vue"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.engine.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
